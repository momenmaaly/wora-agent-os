# ── Database (MongoDB Atlas or self-hosted) ──
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/wora?retryWrites=true&w=majority

# ── Redis (use a strong random password in production) ──
REDIS_PASSWORD=change-me-to-a-strong-32-char-secret
REDIS_URL=redis://localhost:6379

# ── Server & Scaling ──
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
MAX_SOCKETS=6000
AI_CONCURRENCY=30
AI_REQUEST_TIMEOUT_MS=90000

# ── Security & CORS ──
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://your-domain.com
# Optional, server-only, distinct random admin key (global model changes disabled without it)
ADMIN_API_KEY=
# Required in production. Generate a random signing secret with `openssl rand -hex 32`.
AUTH_SECRET=
# Secret-at-rest keyring. Prefer a 0600 JSON file; never commit key material.
# JSON: {"active":"v1","keys":{"v1":"<openssl rand -base64 32>"}}
WORA_SECRET_KEYS=
WORA_SECRET_KEY=
WORA_SECRET_KEY_FILE=

# ── AI Provider Keys (resolved in-process only; NEVER stored in Redis) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Live Product Studio (optional; requires AUTH_SECRET and the chosen provider key) ──
# Set to google, openai, anthropic, or groq to opt in. Leave empty to use client-side templates.
STUDIO_PROVIDER=
# Optional override from the provider models listed by /api/brains.
STUDIO_MODEL=

# ── Public GitHub skill import (optional; server-only, no private repository grants) ──
GITHUB_SKILLS_TOKEN=

# ── Public API origin (leave empty for a same-origin deployment) ──
VITE_API_URL=
# Optional override for /api/os and /api/os/extensions; leave empty to use VITE_API_URL.
VITE_OS_API=
VITE_SOCKET_URL=

# ── WORA OS core (missions, agents, memory, artifacts — SQLite persistence) ──
# Defaults: ./data/wora-os.db and ./data/workspace relative to the API working directory.
# SQLite is single-writer: run one API replica against this database. The API
# acquires a runtime lease and fails fast if another process owns the same file.
WORA_OS_DB=./data/wora-os.db
WORA_WORKSPACE=./data/workspace
# Comma-separated absolute roots allowed for local marketplaces. Empty disables local sources.
WORA_EXTENSIONS_LOCAL_ROOTS=
# Stdio MCP is disabled by default because no verified container sandbox is shipped.
# `official` allows only the bundled, trusted WORA reference server; community stdio is always refused.
WORA_MCP_STDIO_MODE=disabled
# Resource limits for stdio MCP servers (prlimit). Set 0 only with an external sandbox.
WORA_MCP_RESOURCE_LIMITS=1
WORA_MCP_MEMORY_MB=2048
WORA_MCP_CPU_SECONDS=60
WORA_MCP_FSIZE_MB=32
WORA_MCP_NOFILE=1024
WORA_MCP_NPROC=4096
