# ── Database (MongoDB Atlas or self-hosted) ──
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/wora?retryWrites=true&w=majority

# ── Redis (use a strong random password in production) ──
REDIS_PASSWORD=change-me-to-a-strong-32-char-secret
REDIS_URL=redis://localhost:6379

# ── Server & Scaling ──
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
MAX_SOCKETS=6000
AI_CONCURRENCY=30
AI_REQUEST_TIMEOUT_MS=90000

# ── Security & CORS ──
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://your-domain.com
# Required in production for global admin endpoints (POST /api/agents/:agentId/brain)
ADMIN_API_KEY=change-me-to-a-strong-admin-api-key
# Optional: set to enforce HS256 JWT / HMAC token verification on sockets & room REST APIs
AUTH_SECRET=

# ── AI Provider Keys (resolved in-process only; NEVER stored in Redis) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Client Build Args (leave empty when served behind the same Nginx domain) ──
VITE_API_URL=https://your-api.railway.app
VITE_SOCKET_URL=https://your-api.railway.app
